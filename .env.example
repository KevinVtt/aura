# Copiar a .env y completar. El archivo .env NO se versiona.

# Chat (Groq). Obtener en https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL
DB_PASS=

# Firma de los JWT. Usar un valor largo y aleatorio: `openssl rand -base64 48`
JWT_SECRET=

# Primer administrador: se crea solo si la base está vacía.
# Sin ADMIN_PASSWORD el backend no arranca sobre una base vacía (evita credenciales por defecto).
ADMIN_EMAIL=admin@aura.com
ADMIN_PASSWORD=

# Orígenes permitidos por el servicio IA (CORS), separados por coma.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost
