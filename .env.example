# Copiar a .env y completar. El archivo .env NO se versiona.

# Chat (Groq). Obtener en https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL
DB_PASS=

# Firma de los JWT. Usar un valor largo y aleatorio: `openssl rand -base64 48`
JWT_SECRET=

# Primer administrador: se crea solo si la base está vacía.
# Sin ADMIN_PASSWORD el backend no arranca sobre una base vacía (evita credenciales por defecto).
# Es la ÚNICA cuenta que puede entrar con email y contraseña; el resto entra con Google.
ADMIN_EMAIL=admin@aura.com
# Dominios de correo permitidos, separados por coma (vacio = cualquiera)
ALLOWED_EMAIL_DOMAINS=
ADMIN_PASSWORD=

# Orígenes permitidos por el servicio IA (CORS), separados por coma.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Token compartido entre backend e IA. Vacio = sin control (solo local).
# Con esto, aunque la IA quede expuesta, no acepta pedidos sin el header.
IA_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Login con Google (Google Cloud Console > Credenciales > ID de cliente OAuth,
# tipo "Aplicación web"). El backend valida el token con este mismo ID.
# Gratis: alcanza con dejar la pantalla de consentimiento en modo "Prueba" y
# cargar a mano los mails habilitados (límite de 100).
GOOGLE_CLIENT_ID=
# El frontend lo recibe en tiempo de build (Dockerfile ARG), por eso se repite.
REACT_APP_GOOGLE_CLIENT_ID=
